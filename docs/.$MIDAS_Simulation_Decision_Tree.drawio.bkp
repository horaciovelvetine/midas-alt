        <mxCell id="EqCCOF2JMBVHCbhCQh1_-29" parent="1" style="whiteSpace=wrap;html=1;fillColor=#6d8764;fontColor=#ffffff;strokeColor=#3A5431;" value="Resiliency Grading" vertex="1">
